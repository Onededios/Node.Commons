{
  "name": "@onededios/node-commons",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "inherit": "node scripts/inherit.js",
    "generate": "node scripts/generate.js",
    "build": "nx run-many --target=build --all",
    "test": "nx run node-commons:test",
    "test:coverage": "nx run node-commons:test:coverage",
    "test:watch": "vitest --ui",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format:write",
    "watch": "tsc --watch",
    "doc": "typedoc --options typedoc.json",
    "doc:open": "start ./docs/index.html"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "21.3.11",
    "@nx/eslint-plugin": "21.3.11",
    "@nx/vite": "^21.3.11",
    "@nx/web": "21.3.11",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "nx": "^21.3.11",
    "prettier": "^2.6.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@nx/js": "^21.3.11",
    "@nx/plugin": "^21.3.11",
    "@onedios/node-commons-inherit": "file:packages/inherit",
    "typedoc": "^0.28.10",
    "vitest": "^3.2.4"
  },
  "nx": {
    "includedScripts": []
  }
}
